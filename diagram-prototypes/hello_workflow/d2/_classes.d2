classes: {
    process: {
    style: {fill: "#ffec99"; stroke: "#1e1e1e"; border-radius: 12; font-size: 18; bold: true; shadow: true}
    }
    file: {
    style: {fill: "#a5d8ff"; stroke: "#1e1e1e"; border-radius: 8; font-size: 16; bold: false}
    }
    value: {
    style: {fill: "#ffffff"; stroke: "#1e1e1e"; border-radius: 6; font-size: 16; bold: false}
    }
    param: {
    shape: text
    style: {font-size: 16; font-color: "#495057"; italic: true}
    }
    note: {
    shape: text
    style: {font-size: 16; font-color: "#1e1e1e"}
    }
    group: {
    style: {fill: "#f8f9fa"; stroke: "#adb5bd"; stroke-dash: 4; border-radius: 16; font-size: 15}
    }
    channel: {
    style: {fill: "#b2f2bb"; stroke: "#1e1e1e"; border-radius: 12; font-size: 15}
    }
    frame: {
    style: {fill: "#ffffff"; stroke: "#1e1e1e"; border-radius: 16; font-size: 15}
    }
    blank: {
    label: ""
    style: {opacity: 0}
    }
    bare: {
    style: {fill: transparent; stroke: transparent; font-size: 15}
    }
    stub: {
    label: ""
    width: 40
    height: 40
    style: {fill: "#b2f2bb"; stroke: "#1e1e1e"; border-radius: 6}
    }
}
