---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AllCourses from '../../components/course/AllCourses.astro';
import { locales } from '../../locales.mjs';

export function getStaticPaths() {
  return Object.keys(locales).map((key) => ({ params: { lang: key === 'root' ? undefined : key } }));
}

const t = Astro.locals.t;
const { lang } = Astro.params;
---

<StarlightPage frontmatter={{ title: t('nf.all.title'), description: t('nf.all.description'), tableOfContents: false }}>
  <AllCourses locale={lang} />
</StarlightPage>
