---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { markdownToHtml } from 'satteri';
import { icon } from '../icons.mjs';

interface Props {
  frontmatter?: Record<string, any>;
}

const { additional_information: info = {} } = Astro.props.frontmatter ?? {};
const { t } = Astro.locals;
const locale = Astro.currentLocale;

// ponytail: links here resolve from the site root (`/envsetup/`, `../../hello_nextflow/index.md`); a link to a sibling page would need the page's own path.
const localizeLinks = {
  name: 'course-info-links',
  element: {
    filter: ['a'],
    visit(node: any, ctx: any) {
      const href = node.properties?.href;
      if (typeof href !== 'string' || /^([a-z][a-z\d+.-]*:|#|\/\/)/i.test(href)) return;
      const slug = href.replace(/^(\.{0,2}\/)+/, '').replace(/(index)?\.mdx?$/, '');
      // starlight-llms-txt routes have no locale.
      ctx.setProperty(node, 'href', locale ? getRelativeLocaleUrl(locale, slug) : import.meta.env.BASE_URL + slug);
    },
  },
};
const md = (text: string) => markdownToHtml(text, { hastPlugins: [localizeLinks] }).html;

// `**Audience:** text` items describe who the course is for; the rest (skills, prerequisites) what you need.
const forWho = /^\*\*(Audience|Domain)/i;
const stripLabel = (s: string) => s.replace(/^\*\*[^*]+:\*\*\s*/, '');
const prereqs: string[] = info.audience_prerequisites ?? [];
const who = prereqs.filter((p) => forWho.test(p)).map(stripLabel);
const tech = info.technical_requirements;
const need = [
  ...prereqs.filter((p) => !forWho.test(p)).map(stripLabel),
  ...(tech ? [tech === true ? t('courseInfo.defaultTechnicalRequirements') : tech] : []),
];
const playlist = info.videos_playlist;
const videos = playlist
  ? `${t('courseInfo.defaultVideos')} [${t('courseInfo.viewPlaylist')}](${playlist})`
  : info.videos;
const objectives: string[] = info.learning_objectives ?? [];
const para = (items: string[]) => md(items.join('\n\n'));
---

{objectives.length > 0 && (
  <section class="nf-course-info not-content">
    <h2 id="what-youll-learn">{t('nf.course.learn')}</h2>
    <ul class="learn">
      {objectives.map((o) => (
        <li>
          <Fragment set:html={icon('check', 18, 2.5)} />
          <span set:html={markdownToHtml(o).html.replace(/^<p>|<\/p>\s*$/g, '')} />
        </li>
      ))}
    </ul>
  </section>
)}
{(who.length > 0 || need.length > 0) && (
  <section class="nf-course-info not-content">
    <h2 id="before-you-start">{t('nf.course.before')}</h2>
    <div class="cards">
      {who.length > 0 && (
        <div class="card">
          <h3>{t('nf.course.whoFor')}</h3>
          <div set:html={para(who)} />
        </div>
      )}
      {need.length > 0 && (
        <div class="card">
          <h3>{t('nf.course.youNeed')}</h3>
          <div set:html={para(need)} />
        </div>
      )}
    </div>
    {videos && <div class="videos" set:html={md(videos)} />}
  </section>
)}

<style>
  .nf-course-info {
    margin-top: 48px;
  }
  h2 {
    margin: 0 0 16px;
    font-family: var(--nf-font-display);
    font-size: 32px;
    font-weight: 500;
    line-height: 1.15;
    color: var(--nf-ink);
  }
  .learn {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 10px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .learn li {
    display: flex;
    gap: 10px;
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .learn :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--nf-link);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 14px;
  }
  .card {
    padding: 18px 20px;
    border: 1px solid var(--nf-card-border);
    border-radius: var(--nf-radius-md);
    color: var(--nf-muted);
    font-size: 15px;
    line-height: 1.55;
  }
  .card h3 {
    margin: 0 0 6px;
    color: var(--nf-ink);
    font-family: var(--nf-font-body);
    font-size: 16px;
    font-weight: 600;
  }
  .card :global(p) {
    margin: 0 0 8px;
  }
  .card :global(p:last-child) {
    margin: 0;
  }
  .card :global(a),
  .videos :global(a) {
    color: var(--nf-link);
  }
  .videos {
    margin-top: 14px;
    color: var(--nf-muted);
    font-size: 14px;
  }
</style>
