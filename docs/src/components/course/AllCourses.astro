---
import { formatMinutes, getCatalog, type Course } from '../../catalog';
import { groups } from '../../courses.mjs';
import { icon } from '../../icons.mjs';

interface Props {
  locale?: string;
}
const { locale } = Astro.props;
const t = Astro.locals.t;
const prefix = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${locale ? `${locale}/` : ''}`;
const { courses, sideQuests } = await getCatalog();
const titleOf = (id: string) => courses.find((c) => c.id === id)?.title ?? id;
const meta = (c: Course) =>
  [t('nf.home.parts', { n: c.parts.length }), !c.partial && formatMinutes(c.minutes)].filter(Boolean).join(' · ');
const buildsOn = (c: Course) =>
  c.buildsOn.length ? t('nf.all.buildsOn', { courses: c.buildsOn.map(titleOf).join(t('nf.all.and')) }) : '';
const sections = [
  { key: 'run', lede: t('nf.all.run') },
  { key: 'write', lede: t('nf.all.write') },
] as const;
const science = courses.filter((c) => c.group === 'science');
const search = (...text: (string | undefined)[]) => text.filter(Boolean).join(' ').toLowerCase();
---

<nf-course-filter class="all not-content">
  <label class="filter">
    <Fragment set:html={icon('search', 18)} />
    <input type="search" placeholder={t('nf.sb.filter')} aria-label={t('nf.sb.filter')} autocomplete="off" />
  </label>
  <div class="sections" role="group" aria-label={t('nf.all.sections')}>
    {[
      ['run', groups.run],
      ['write', groups.write],
      ['side-quests', sideQuests.title],
      ['science', groups.science],
    ].map(([id, label]) => (
      <button type="button" class="chip" data-section={id} aria-pressed="false">
        {label}
      </button>
    ))}
  </div>
  <p class="none" hidden>
    {t('nf.sb.noMatch')}
  </p>
  {sections.map(({ key, lede }) => (
    <section data-section={key}>
      <h2 id={key}>{groups[key]}</h2>
      <p class="lede">{lede}</p>
      <div class="grid">
        {courses
          .filter((c) => c.group === key)
          .map((c) => (
            <a class="card" href={`${prefix}${c.id}/`} data-search={search(c.title, c.blurb, c.description)}>
              <span class="title-row">
                <span class="title">{c.title}</span>
                {!c.buildsOn.length && <span class="badge">{t('nf.all.firstCourse')}</span>}
              </span>
              <span class="blurb">{c.blurb}</span>
              <span class="meta">
                <span class="nf-meta">{meta(c)}</span>
                {buildsOn(c) && <span> · {buildsOn(c)}</span>}
              </span>
            </a>
          ))}
      </div>
    </section>
  ))}

  <section data-section="side-quests">
    <h2 id="side-quests">{sideQuests.title}</h2>
    <p class="lede">{t('nf.all.sq')}</p>
    <div class="grid quests">
      {sideQuests.groups.flatMap((g) =>
        g.quests.map((q) => (
          <a class="card" href={`${prefix}${q.slug}/`} data-search={search(q.title, q.description, g.label)}>
            <span class="title">{q.title}</span>
            <span class="blurb">{g.label}</span>
            {q.minutes && (
              <span class="meta">
                <span class="nf-meta">{formatMinutes(q.minutes)}</span>
              </span>
            )}
          </a>
        )),
      )}
    </div>
  </section>

  <section data-section="science">
    <h2 id="science">{groups.science}</h2>
    <p class="lede">{t('nf.all.science')}</p>
    <div class="grid science">
      {science.map((c) => (
        <a class="card" href={`${prefix}${c.id}/`} data-search={search(c.title, c.blurb, c.description)}>
          <span class="title">{c.title}</span>
          <span class="blurb">{c.blurb}</span>
          <span class="meta">
            <span class="nf-meta">{meta(c)}</span>
            {buildsOn(c) && <span> · {buildsOn(c)}</span>}
          </span>
        </a>
      ))}
    </div>
  </section>
</nf-course-filter>

<script>
  class CourseFilter extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input')!;
      const chips = [...this.querySelectorAll<HTMLButtonElement>('.chip')];
      let only = '';
      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let any = false;
        for (const section of this.querySelectorAll<HTMLElement>('section')) {
          let shown = 0;
          if (!only || section.dataset.section === only) {
            for (const card of section.querySelectorAll<HTMLElement>('.card')) {
              card.hidden = !!q && !card.dataset.search!.includes(q);
              if (!card.hidden) shown++;
            }
          }
          section.hidden = !shown;
          any ||= shown > 0;
        }
        this.querySelector<HTMLElement>('.none')!.hidden = any;
      };
      input.addEventListener('input', apply);
      // One section at a time; picking the active one again shows them all.
      for (const chip of chips) {
        chip.addEventListener('click', () => {
          only = only === chip.dataset.section ? '' : chip.dataset.section!;
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.section === only)));
          apply();
        });
      }
    }
  }
  customElements.define('nf-course-filter', CourseFilter);
</script>

<style>
  .filter {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 14px;
    border: 1px solid var(--nf-line-2);
    border-radius: var(--nf-radius-sm);
    background: var(--nf-surface);
    color: var(--nf-muted);
  }
  .filter:focus-within {
    border-color: var(--nf-green);
  }
  .filter input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--nf-ink);
    font: inherit;
    font-size: 16px;
    outline: none;
  }
  .sections {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: -40px;
  }
  .chip {
    min-height: 40px;
    padding: 6px 14px;
    border: 1px solid var(--nf-line-2);
    border-radius: 999px;
    background: var(--nf-surface);
    color: var(--nf-ink);
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--nf-green);
  }
  .chip[aria-pressed='true'] {
    border-color: var(--nf-green);
    background: var(--nf-on-bg);
    color: var(--nf-on-ink);
    font-weight: 600;
  }
  .none {
    margin: 0;
    color: var(--nf-muted);
  }
  [hidden] {
    display: none !important;
  }
  .all {
    display: flex;
    flex-direction: column;
    gap: 56px;
    margin-top: 16px;
  }
  h2 {
    margin: 0;
    color: var(--nf-ink);
    font-family: var(--nf-font-display);
    font-size: 36px;
    font-weight: 500;
    line-height: 1.15;
  }
  .lede {
    margin: 6px 0 20px;
    color: var(--nf-muted);
    font-size: 17px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }
  .grid.quests {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    border: 1px solid var(--nf-card-border);
    color: var(--nf-ink);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--nf-link);
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }
  .badge {
    padding: 1px 8px;
    border: 1px solid #b6ece2;
    border-radius: var(--nf-radius-sm);
    background: var(--nf-on-bg);
    color: var(--nf-on-ink);
    font-size: 13px;
    font-weight: 600;
  }
  .blurb {
    color: var(--nf-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .meta {
    margin-top: auto;
    color: var(--nf-muted);
    font-size: 13px;
    line-height: 1.6;
  }
  .quests .card {
    padding: 16px 18px;
  }
  .quests .title {
    font-size: 16px;
  }
</style>
