---
import EditLink from 'virtual:starlight/components/EditLink';
import Default from 'starlight-quiz/overrides/Footer.astro';

const { t } = Astro.locals;
const llmsTxt = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}llms.txt`;
---

<Default>
  <slot />
</Default>

{/* The edit link moves below the pagination, next to the licence line. */}
<div class="site-footer">
  <EditLink />
  <p>
    <span>{t('nf.footer.content', { year: new Date().getFullYear() })}</span>
    <a href={llmsTxt}>llms.txt</a>
    <button type="button" id="consent-open">
      Cookie settings
    </button>
  </p>
</div>

{/* A manual popover, not a modal: it sits above the page without blocking it or taking focus. */}
{/* It stays at the end of the tab order, after all the page content. */}
<div id="consent" popover="manual" role="dialog" aria-labelledby="consent-title" aria-describedby="consent-description">
  <form>
    <h2 id="consent-title" class="nf-sr-only">
      {t('consent.title')}
    </h2>
    <p id="consent-description" set:html={t('nf.consent.short')} />
    <div id="consent-settings" hidden>
      <label>
        <input type="checkbox" name="analytics" checked /> Google Analytics
      </label>
      <label>
        <input type="checkbox" name="posthog" checked /> {t('consent.posthog')}
      </label>
    </div>
    <div class="controls">
      <button value="accept">Accept</button>
      <button value="reject" class="quiet">
        Reject
      </button>
      <button type="button" class="manage quiet" aria-expanded="false" aria-controls="consent-settings">
        Settings
      </button>
    </div>
  </form>
</div>

<script>
  type Consent = Record<string, boolean>;

  // Material for MkDocs' key under `extra.scope: /`, so choices made on the old site carry over.
  const KEY = '/.__consent';
  const GA_ID = 'G-244N3GEN75';

  const dialog = document.getElementById('consent')!;
  const form = dialog.querySelector('form')!;
  const settings = document.getElementById('consent-settings')!;
  const manage = form.querySelector<HTMLButtonElement>('.manage')!;
  const boxes = [...form.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];

  function read(): Consent | null {
    try {
      return JSON.parse(localStorage.getItem(KEY)!);
    } catch {
      return null;
    }
  }

  function addScript(src: string) {
    const script = Object.assign(document.createElement('script'), { src, async: true });
    document.head.append(script);
    return script;
  }

  let started: Consent = {};
  function start(consent: Consent) {
    const w = window as any;
    if (consent.analytics && !started.analytics) {
      w.dataLayer = w.dataLayer || [];
      w.gtag = function () {
        w.dataLayer.push(arguments);
      };
      w.gtag('js', new Date());
      w.gtag('config', GA_ID);
      addScript(`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`);
    }
    if (consent.posthog && !started.posthog) {
      addScript('https://eu-assets.i.posthog.com/static/array.js').onload = () =>
        w.posthog.init('phc_pLVMvF3StGtifZ71oQrnQ99FGD1luzjIcG3xrs1PIaW', {
          api_host: 'https://eu.i.posthog.com',
          person_profiles: 'always',
          persistence: 'localStorage',
        });
    }
    started = { ...started, ...consent };
  }

  function showSettings(show: boolean) {
    settings.hidden = !show;
    manage.setAttribute('aria-expanded', String(show));
  }

  manage.addEventListener('click', () => showSettings(settings.hidden));

  document.getElementById('consent-open')!.addEventListener('click', () => {
    const consent = read();
    for (const box of boxes) box.checked = consent ? !!consent[box.name] : true;
    showSettings(true);
    dialog.showPopover();
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    dialog.hidePopover();
    const reject = (event.submitter as HTMLButtonElement | null)?.value === 'reject';
    const next: Consent = Object.fromEntries(boxes.map((box) => [box.name, !reject && box.checked]));
    const previous = read() ?? {};
    try {
      localStorage.setItem(KEY, JSON.stringify({ ...previous, ...next }));
    } catch {}
    // Loaded trackers can't be unloaded, so a withdrawal needs a fresh page.
    if (Object.keys(next).some((name) => started[name] && !next[name])) location.reload();
    else start(next);
  });

  const consent = read();
  if (consent) start(consent);
  else dialog.showPopover();
</script>

<style>
  :global(footer > .meta) {
    display: none;
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--nf-line);
    font-size: 13px;
    color: var(--nf-muted);
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .site-footer svg {
    width: 1em;
    height: 1em;
    margin-inline-end: 0.25em;
    vertical-align: -0.125em;
  }
  .site-footer a,
  #consent-open {
    color: inherit;
  }
  .site-footer a:hover,
  #consent-open:hover {
    color: var(--sl-color-white);
  }
  #consent-open {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  #consent {
    position: fixed;
    inset: auto 16px 16px auto;
    width: min(380px, calc(100vw - 32px));
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--nf-card-border);
    border-radius: var(--nf-radius-md);
    background: var(--nf-surface);
    color: var(--nf-ink);
    box-shadow: var(--nf-shadow-pop);
    font-size: 13px;
    line-height: 1.45;
  }
  #consent p {
    margin: 0;
  }
  #consent p :global(a) {
    color: var(--nf-link);
  }
  #consent-settings {
    margin-top: 8px;
  }
  label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block: 0.25rem;
    cursor: pointer;
  }
  input {
    accent-color: var(--nf-green);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .controls button {
    min-height: 32px;
    padding: 4px 12px;
    border: 1px solid var(--nf-green);
    border-radius: var(--nf-radius-sm);
    background: var(--nf-mint);
    color: var(--nf-on-mint);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .controls .quiet {
    border-color: var(--nf-line-3);
    background: var(--nf-surface);
    color: var(--nf-ink);
  }
  .controls .quiet:hover {
    border-color: var(--nf-link);
  }
  @media (max-width: 640px) {
    #consent {
      inset: auto 8px 8px;
      width: auto;
    }
  }
</style>
