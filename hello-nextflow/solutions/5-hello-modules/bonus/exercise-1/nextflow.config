docker.enabled = true

/*
 * Pipeline parameters
 */
params {
    language = 'es'
    batch = 'batch'
    character = 'turkey'
}

/*
 * Profiles
 */
profiles {
    test {
        params.input = 'data/names.csv'
        params.batch = 'test'
        params.character = 'tux'
    }
    french {
        params.language = 'fr'
    }
    conda {
        docker.enabled = false
        conda.enabled = true
    }
}
