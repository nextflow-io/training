/*
 * Resource limits for laptops and development machines
 * Overrides the nf-core default allocations to fit the default Codespaces machine (2 CPUs, 8 GB)
 */
process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = 6.GB
    }
    withLabel: 'process_medium' {
        cpus   = 2
        memory = 6.GB
    }
    withLabel: 'process_high' {
        cpus   = 2
        memory = 6.GB
    }
    withLabel: 'process_high_memory' {
        memory = 6.GB
    }
    withName: '.*:TRIMGALORE' {
        cpus   = 2
    }
}
