# Prettier parses MDX 1, not MDX 3: a fence indented 4 spaces after a paragraph is a code block
# to Astro, but Prettier rewrites it as inline code. The build still passes.
*.mdx

# MkDocs input for the converter tests, where 4-space list indentation is syntax
_scripts/convert_mkdocs/tests/

# LLM prompts: examples must match the pages exactly, and any change marks all translations outdated
_scripts/**/*llm-prompt.md

# Ignore all files in side-quests/solutions
side-quests/solutions/nf-core/**/*.js
side-quests/solutions/nf-core/**/*.md
side-quests/solutions/nf-core/**/*.yaml
side-quests/solutions/nf-core/**/*.json
side-quests/solutions/nf-core/**/*.html
side-quests/solutions/nf-core/**/*.yml

# Ignore nf-core pipeline solutions (generated by nf-core tools, not hand-authored)
hello-nf-core/solutions/core-hello-*/**

# Ignore auto-generated license files in plugin solutions
side-quests/plugin_development/**/COPYING

# Generated by _scripts/convert_mkdocs
docs/src/sidebar.mjs
docs/src/redirects.mjs
docs/src/content/i18n/
